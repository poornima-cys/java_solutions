        int max=Integer.MIN_VALUE;
        int row=grid.length;
        int col=grid[0].length;
        Queue<Pair>q=new LinkedList<>();
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
                if(grid[i][j]==1){
                    c++;
                    q.add(new Pair(i,j));
                    res=traverse(grid, q, row, col, c);
                    max=Math.max(res,max);
                    c=0;
                }
            }
        }
        return Math.max(max,res);
    }
                    grid[i][j]=0;
}
